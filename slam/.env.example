# Copier en .env et adapter
# IP du broker MQTT (ex: instance Mosquitto de Home Assistant) - PAS l'IP
# de l'ESP32/robot, qui n'a pas besoin d'être connu ici (tout passe par
# le broker comme intermédiaire).
MQTT_BROKER=192.168.10.108
MQTT_PORT=1883
MQTT_PREFIX=neato/robot
SLAM_MODE=mapping
REST_PORT=2000
WS_PORT=2001
ROSBRIDGE_PORT=2002
WS_IN_PORT=2003
ROBOT_TYPE=d7_gen3

# Nav2 / coverage_planner - désactivé par défaut, à activer seulement
# après avoir validé GetMotor/GetLDSScan/GetDigitalSensors/GetAnalogSensors
# et testé SetMotor en local (voir slam/diagnose.py --guided).
NAV2_ENABLED=false
CMD_VEL_OUT_TOPIC=neato/robot/cmd_vel_out
MQTT_CLEAN_CMD_TOPIC=neato/robot/clean_cmd
# Dimensions officielles du D7 : largeur 335.5mm, profondeur 319mm.
# ROBOT_RADIUS_M = max(largeur, profondeur) / 2 (rayon circonscrit, le
# choix prudent tant que Nav2 utilise un modèle circulaire et pas la
# vraie forme en D).
ROBOT_RADIUS_M=0.168
# ROW_SPACING_M = largeur de la brosse centrale mesurée (27.5cm) x 0.85
# pour 15% de recouvrement entre deux passages.
ROW_SPACING_M=0.234
